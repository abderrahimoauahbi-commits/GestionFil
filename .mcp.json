{
  "mcpServers": {
    "postgres": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${DATABASE_URL:-postgres://user:password@localhost:5432/erp_db}"
      ]
    },
    "fetch": {
      "command": "python",
      "args": ["-m", "mcp_server_fetch", "--ignore-robots-txt"]
    },
    "sequentialthinking": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "semgrep": {
      "command": "${USERPROFILE}\\AppData\\Roaming\\Python\\Python314\\Scripts\\semgrep.exe",
      "args": ["mcp", "-t", "stdio"],
      "env": {
        "PATH": "${USERPROFILE}\\AppData\\Roaming\\Python\\Python314\\Scripts;${PATH}",
        "SEMGREP_SEND_METRICS": "off"
      }
    }
  }
}
