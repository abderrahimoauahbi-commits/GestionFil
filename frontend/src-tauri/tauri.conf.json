{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestion Fil",
  "version": "0.4.0",
  "identifier": "ma.polyfashions.gestionfil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gestion Fil - Polyfashions Carpet",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "center": true,
        "decorations": true,
        "theme": null,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Polyfashions Carpet Morocco",
    "category": "Business",
    "shortDescription": "Pilotage des achats, stocks et production",
    "longDescription": "ERP de pilotage des achats, des stocks et de la production de matieres premieres pour la fabrication de tapis mecaniques.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://192.168.1.140/api/maj/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQ0VFQjI1QTQ1RjQ2MQpSV1JoOUVWYXN1NnNBKzVjMmR3ZFgrV2RVVTNoY3RITEhtTCs4UytrS2FqYkcwVWFyME5kdTZINwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
