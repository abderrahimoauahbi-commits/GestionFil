                </div>

                {parametrable && (
                  <div className="flex gap-2">
                    <button
                      type="button"
                      onClick={() => setEditee(m)}
                      className="inline-flex min-h-[40px] flex-1 items-center justify-center gap-1.5
                                 rounded-[var(--radius-sm)] border border-bordure text-[13px]
                                 hover:bg-attenue"
                    >
                      <Cog className="size-3.5" />
                      Configurer
                    </button>
                    <button
                      type="button"
                      onClick={() => setEtatDe(m)}
                      className="inline-flex min-h-[40px] flex-1 items-center justify-center gap-1.5
                                 rounded-[var(--radius-sm)] border border-bordure text-[13px]
                                 hover:bg-attenue"
                    >
