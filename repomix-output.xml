import { Carte, CarteCorps, CarteEntete, CarteTitre } from '../composants/ui/base'
import { useOuvrirVue } from '../lib/navigation'
import { cn } from '../lib/utils'

interface EtatDisponible {
  cle: string
  titre: string
  description: string
  chemin: string
  module: string
