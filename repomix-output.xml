                      <td className="px-2 py-1.5 text-right tabular-nums">
                        {nb(s, 'taux_conformite_pct') == null
                          ? '—'
                          : `${fmt.nombre(nb(s, 'taux_conformite_pct')!, 0)} %`}
                      </td>
                      <td className="px-2 py-1.5 text-right">
                        {otif == null ? (
                          <span className="text-attenue-texte">—</span>
                        ) : (
                          <span
