    <Badge ton={tonsHistoriques[ton]} {...props}>
      {children}
    </Badge>
  )
}

type VarianteHistorique = 'principal' | 'secondaire' | 'discret' | 'danger'

const correspondance: Record<VarianteHistorique, 'principal' | 'contour' | 'discret' | 'danger'> = {
  principal: 'principal',
  secondaire: 'contour',
