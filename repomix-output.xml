        let v: Value = serde_json::from_str(&charge_jsonb(&champs)).unwrap();
        assert_eq!(v["actif"], json!(1));
        assert_eq!(v["suivi_lot"], json!(0));
        assert_eq!(v["stock_min_kg"], Value::Null);
        assert_eq!(v["designation"], json!("Jute 24/1"));
    }
}
