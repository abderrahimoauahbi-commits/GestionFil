          de commandes, ou elle est cherchee quand on en a besoin. */}
      <FilActualite />

      {accessibles.length === 0 && (
        <p className="text-[14px] text-attenue-texte">
          Aucun écran ne vous est ouvert. Demandez vos droits à la direction.
        </p>
      )}
    </div>
  )
}
