                        'cursor-pointer border-b border-bordure/60',
                        choisie === code && 'bg-primaire/5',
                      )}
                    >
                      <td className="max-w-56 px-3 py-1.5">
                        <div className="truncate font-medium">{code}</div>
                        <div className="truncate text-[11px] text-attenue-texte">
