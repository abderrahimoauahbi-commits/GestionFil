  const lignesAffichees: LigneRec[] = lignes

  const horsTolerance = useMemo(
    () => lignesAffichees.filter((l) => Math.abs(l.ecart_pct ?? 0) > TOLERANCE_PCT).length,
    [lignesAffichees],
