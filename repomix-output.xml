<file path="frontend/src/pages/Telecharger.tsx">
/**
 * Telecharger l'application.
 *
 * UNE LIGNE PAR SYSTEME, UN BOUTON, LA VERSION. Rien d'autre.
 *
 * Les deux versions precedentes de cet ecran expliquaient : la compatibilite,
 * le geste d'installation, ce qui manquait et pourquoi, un bandeau de support.
 * Tout cela etait vrai et personne ne le lit. On vient ici pour prendre un
 * fichier ; l'ecran doit le donner, pas l'accompagner d'une notice.
 *
 * LE BOUTON EST UN VRAI LIEN. Il passait par `fetch` parce que la route d'API
 * exigeait un jeton dans un en-tete — un detour invisible, mais un bouton qui
 * n'est pas un lien ne s'ouvre pas dans un onglet, ne se copie pas, ne se colle
 * pas dans un courriel. Les paquets sont donc servis en fichiers sous
 * `/telechargements/`, comme chez tout editeur : un installateur n'est pas un
 * secret.
 *
 * LE JOURNAL RESTE, ecrit au clic. Savoir sur quelle version tourne un poste est
 * la seule question qu'on se pose apres coup.
 */
import { useQuery } from '@tanstack/react-query'
import { Download } from 'lucide-react'
import { api, serveur } from '../api/client'
import { useAuth, useDroits } from '../auth/AuthContext'
import { EnTetePage } from '../composants/Coquille'
import { Alerte, Badge, Chargement } from '../composants/ui/base'
import { TableDroits, type Colonne } from '../components/TableDroits'
import { fmt } from '../lib/utils'

const MODULE = 'PARAMETRES'

interface Paquet {
  fichier: string
  plateforme: string
  plateforme_libelle: string
  version: string
  taille_octets: number
  nb_telechargements: number
}

interface LigneJournal extends Record<string, unknown> {
  fichier: string
  plateforme: string
  version: string
  date_telechargement: string
  utilisateur: string
  adresse_ip?: string | null
}

export function Telecharger() {
  const { peut } = useAuth()
  const droits = useDroits(MODULE)

  const qPaquets = useQuery({
    queryKey: ['telechargements'],
    queryFn: () => api.get<Paquet[]>('/api/telechargements'),
  })
  const qJournal = useQuery({
    queryKey: ['telechargements-journal'],
    queryFn: () => api.get<LigneJournal[]>('/api/telechargements/journal'),
    enabled: peut(MODULE, 'LIRE'),
  })

  const colonnes: Colonne<LigneJournal>[] = [
    {
      champ: 'date_telechargement',
      entete: 'Telecharge le',
      rendu: (l) => fmt.dateHeure(l.date_telechargement),
    },
    { champ: 'utilisateur', entete: 'Par' },
    { champ: 'plateforme', entete: 'Plateforme' },
    {
      champ: 'version',
      entete: 'Version',
      rendu: (l) => <span className="font-mono text-xs">{l.version}</span>,
    },
    {
      champ: 'fichier',
      entete: 'Fichier',
      secondaire: true,
      rendu: (l) => <span className="font-mono text-[11px]">{l.fichier}</span>,
    },
  ]

  if (qPaquets.isLoading) return <Chargement texte="Lecture des paquets…" />
  const paquets = qPaquets.data ?? []

  /* LA DERNIERE VERSION D'ABORD, LE RESTE EN DESSOUS.
     L'ecran empilait toutes les versions jamais publiees — Windows 0.1.0,
     0.3.0, 0.4.0, Linux 0.1.0, 0.3.0 — au meme rang et dans l'ordre du
     systeme de fichiers. Celui qui vient installer l'ERP ne sait pas laquelle
     prendre, et rien ne le lui dit. Or dans quatre-vingt-dix-neuf cas sur
     cent, la reponse est « la plus recente pour ma machine ».
     Les anciennes ne disparaissent pas : elles descendent. On en a besoin le
     jour ou une version neuve pose un probleme et qu'il faut revenir. */
  const rang = (v: string) =>
    v.split(/[.\-+]/).reduce((a, x) => a * 1000 + (parseInt(x, 10) || 0), 0)

  const derniers = new Map<string, Paquet>()
  for (const p of paquets) {
    const tenant = derniers.get(p.plateforme)
    if (!tenant || rang(p.version) > rang(tenant.version)) derniers.set(p.plateforme, p)
  }
  const courants = [...derniers.values()].sort((a, b) =>
    a.plateforme_libelle.localeCompare(b.plateforme_libelle),
  )
  const anciens = paquets
    .filter((p) => derniers.get(p.plateforme)?.fichier !== p.fichier)
    .sort((a, b) => rang(b.version) - rang(a.version))

  return (
    <div>
      <EnTetePage titre="Télécharger l application" />

      {paquets.length === 0 ? (
        <Alerte ton="info" titre="Aucun paquet publie">
          Deposer les installateurs dans le dossier des paquets du serveur. Le nom porte la
          plateforme et la version : <code>gestionfil-windows-0.1.0.exe</code>.
        </Alerte>
      ) : (
        <div className="max-w-2xl divide-y divide-bordure rounded-[var(--radius-lg)] border border-bordure bg-surface shadow-[var(--ombre-pose)]">
          {courants.map((p) => (
            <div key={p.fichier} className="flex items-center gap-4 px-4 py-3">
              <div className="min-w-0 flex-1">
                <div className="flex items-center gap-2">
                  <span className="text-[14px] font-medium text-texte">
                    {p.plateforme_libelle}
                  </span>
                  <Badge ton="succes">derniere version</Badge>
                </div>
                <div className="text-[12px] tabular-nums text-attenue-texte">
                  Version {p.version} · {(p.taille_octets / 1e6).toFixed(1)} Mo
                </div>
              </div>

              {/* UN VRAI LIEN : il s'ouvre dans un onglet, se copie, se colle.
                  `download` demande l'enregistrement plutot que l'affichage. Le
                  clic inscrit au passage la ligne du journal ; s'il echoue, le
                  telechargement part quand meme — la trace ne vaut pas qu'on
                  prive quelqu'un de son installateur. */}
              <a
                href={`${serveur()}/telechargements/${encodeURIComponent(p.fichier)}`}
                download={p.fichier}
                onClick={() => {
                  void api
                    .post('/api/telechargements/journal', { fichier: p.fichier })
                    .then(() => qJournal.refetch())
                    .catch(() => undefined)
                }}
                className="inline-flex shrink-0 items-center gap-1.5 rounded-[var(--radius-sm)]
                           bg-primaire px-3 py-1.5 text-[13px] font-medium text-primaire-texte
                           transition-[filter] hover:brightness-110"
              >
                <Download className="size-4" />
                Telecharger
              </a>
            </div>
          ))}
        </div>
      )}

      {/* LES VERSIONS PRECEDENTES, REPLIEES.
          Elles servent le jour ou une version neuve pose un probleme et qu'il
          faut revenir en arriere — cas rare, mais sans issue quand le fichier
          a disparu. Repliees, elles ne brouillent plus le choix courant. */}
      {anciens.length > 0 && (
        <details className="mt-3 max-w-2xl">
          <summary
            className="cursor-pointer select-none text-[12px] text-attenue-texte
                       transition-colors hover:text-texte"
          >
            Versions precedentes ({anciens.length})
          </summary>
          <ul className="mt-2 divide-y divide-bordure/60 rounded-[var(--radius)] border border-bordure">
            {anciens.map((p) => (
              <li
                key={p.fichier}
                className="flex items-center justify-between gap-3 px-3 py-2 text-[12px]"
              >
                <span className="text-attenue-texte">
                  {p.plateforme_libelle} · version {p.version}
                </span>
                <a
                  href={`${serveur()}/telechargements/${encodeURIComponent(p.fichier)}`}
                  download={p.fichier}
                  className="text-primaire underline-offset-2 hover:underline"
                >
                  Telecharger
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      {droits.peutLire && (
        <>
          <h2 className="mb-2 mt-6 text-sm font-semibold text-texte">
            Journal des telechargements
          </h2>
          <TableDroits
            exportable="journal-des-telechargements"
            module={MODULE}
            colonnes={colonnes}
            lignes={qJournal.data ?? []}
            chargement={qJournal.isLoading}
            cle={(l) => `${l.date_telechargement}-${l.fichier}-${l.utilisateur}`}
            titreCarte={(l) => `${l.plateforme} ${l.version}`}
            texteVide="Aucun telechargement pour l instant."
          />
        </>
      )}
    </div>
  )
}
</file>

<file path="frontend/src/index.css">
@import "tailwindcss";

/* INTER EST EMBARQUEE, PAS APPELEE DEHORS.
   La police etait NOMMEE dans `--font-sans` mais jamais fournie : sur un poste
   de l'usine qui ne l'a pas installee — c'est-a-dire tous — l'ERP retombait sur
   Segoe UI. Le dessin qu'on avait choisi n'etait donc visible nulle part.
   Un appel a Google Fonts ne reglerait rien : le reseau de Tanger n'a pas
   d'acces internet garanti, et une police qui n'arrive pas fait sauter la mise
   en page a l'ouverture. Elle est donc servie avec l'application. */
@import "@fontsource-variable/inter";

/* =============================================================================
   Jetons de design
   -----------------------------------------------------------------------------
   Palette definie en HSL pour que les variantes (survol, bordure, etat actif)
   se derivent par decalage de luminosite plutot que par une liste de couleurs
   figees. Le theme sombre ne redefinit que les jetons, jamais les composants.
   ========================================================================== */

@theme {
  --font-sans: "Inter Variable", "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
  --font-mono: "JetBrains Mono", "Cascadia Mono", ui-monospace, monospace;

  /* Rayon court : un tableau de bord d'administration se lit mieux avec des
     angles nets qu'avec des cartes arrondies facon site vitrine. */
  --radius: 0.5rem;
  --radius-sm: calc(var(--radius) - 3px);
  --radius-lg: calc(var(--radius) + 4px);

  /* ---------------------------------------------------------------------
     ELEVATION
     ---------------------------------------------------------------------
     Il n'y en avait aucune : tout etait plat, separe par des traits. Sur un
     ecran dense, le trait ne suffit pas a dire ce qui est POSE SUR quoi — une
     carte, un menu deroulant et une boite de dialogue se ressemblaient.

     Quatre niveaux, pas davantage, et tous tres doux : deux ombres
     superposees, l'une courte et franche pour le contact, l'autre longue et
     diffuse pour la distance. Une seule ombre large donne le halo gris
     caracteristique des interfaces bricolees. */
  --ombre-pose: 0 1px 2px -1px hsl(215 30% 20% / 0.08), 0 1px 3px hsl(215 30% 20% / 0.05);
  --ombre-levee: 0 2px 4px -2px hsl(215 30% 20% / 0.10), 0 4px 12px -2px hsl(215 30% 20% / 0.08);
  --ombre-flottante: 0 4px 8px -4px hsl(215 30% 20% / 0.12), 0 12px 28px -6px hsl(215 30% 20% / 0.14);
  --ombre-modale: 0 8px 16px -8px hsl(215 30% 20% / 0.16), 0 24px 56px -12px hsl(215 30% 20% / 0.22);

  /* Une transition unique pour tout ce qui reagit au survol : des durees
     differentes d'un composant a l'autre donnent une interface qui « flotte »
     sans qu'on sache pourquoi. */
  --transition-douce: 140ms cubic-bezier(0.4, 0, 0.2, 1);
}

:root {
  /* Le fond de page est legerement gris : les cartes blanches s'en detachent
     sans avoir besoin d'ombre, et la page cesse d'etre un aplat uniforme. */
  /* LE GRIS N'EST PAS NEUTRE, IL PENCHE.
     Un gris pur (0% de saturation) sous un accent bleu donne cette grisaille
     d'imprimante qu'on reconnait a dix metres. Tous les neutres portent ici
     une trace du bleu de l'accent : le fond, les traits et le texte attenue
     appartiennent alors a la meme famille que le reste, et l'ecran se tient. */
  --fond: 215 30% 97.5%;
  --texte: 217 33% 15%;

  --surface: 0 0% 100%;
  --surface-texte: 217 33% 15%;

  --attenue: 215 28% 96.5%;
  --attenue-texte: 215 16% 47%;

  --accent: 217 33% 15%;
  --accent-texte: 0 0% 100%;

  /* BLEU NUIT PLUTOT QUE BLEU VIF. Le bleu precedent (80% de saturation)
     tirait vers le lien hypertexte des annees 2000 ; celui-ci est plus
     profond, plus calme, et supporte d'etre pose en aplat sur un bouton sans
     crier. Il reste assez fonce pour passer le contraste AA sur blanc. */
  --primaire: 221 62% 33%;
  --primaire-texte: 0 0% 100%;

  /* L'OR ANCIEN, signature de la maison (#C4A15A). Il ne sert jamais d'accent
     principal — il souligne : un filet, un chiffre qui compte, une bordure de
     carte mise en avant. Employe en aplat, il vire au jaune moutarde. */
  --or: 41 46% 56%;

  --danger: 358 64% 46%;
  --danger-texte: 0 0% 100%;

  --succes: 154 58% 32%;
  --alerte: 30 85% 44%;
  --info: 210 72% 40%;

  /* Deux niveaux de trait : `bordure` cerne les blocs, `ligne` separe les
     lignes d'un tableau. Un seul niveau donne soit des tableaux zebres de
     traits noirs, soit des cartes sans contour. */
  /* DES FILETS PLUS FINS QU'AVANT. A 88% de luminosite, le trait se lisait
     comme un cadre ; a 91%, il separe sans enfermer — c'est ce que font les
     interfaces qu'on trouve elegantes, et cela ne coute que trois points. */
  --bordure: 215 22% 91%;
  --ligne: 215 24% 94.5%;
  --champ: 215 20% 86%;
  --anneau: 221 62% 33%;

  --barre: 215 30% 15%;
  --barre-texte: 210 20% 94%;
  --barre-attenue: 215 16% 62%;
  --barre-actif: 215 28% 24%;

  color-scheme: light;
}

.sombre {
  --fond: 222 30% 9%;
  --texte: 210 20% 92%;

  --surface: 220 26% 13%;
  --surface-texte: 210 20% 92%;

  --attenue: 218 24% 17%;
  --attenue-texte: 215 15% 62%;

  --accent: 210 20% 92%;
  --accent-texte: 222 30% 9%;

  --primaire: 214 90% 62%;
  --primaire-texte: 222 40% 10%;

  /* L'or tient sur fond graphite sans etre retouche : c'est ce qui en fait
     une signature utilisable dans les deux themes. */
  --or: 41 52% 62%;

  --danger: 0 65% 55%;
  --danger-texte: 0 0% 100%;

  --succes: 152 50% 48%;
  --alerte: 35 85% 58%;
  --info: 205 80% 58%;

  --bordure: 218 20% 24%;
  --ligne: 218 20% 19%;
  --champ: 218 20% 26%;
  --anneau: 214 90% 62%;

  --barre: 222 32% 8%;
  --barre-texte: 210 20% 92%;
  --barre-attenue: 215 14% 55%;
  --barre-actif: 218 24% 18%;

  --ombre-pose: 0 1px 2px -1px hsl(0 0% 0% / 0.30), 0 1px 3px hsl(0 0% 0% / 0.24);
  --ombre-levee: 0 2px 4px -2px hsl(0 0% 0% / 0.36), 0 4px 12px -2px hsl(0 0% 0% / 0.30);
  --ombre-flottante: 0 4px 8px -4px hsl(0 0% 0% / 0.44), 0 12px 28px -6px hsl(0 0% 0% / 0.40);
  --ombre-modale: 0 8px 16px -8px hsl(0 0% 0% / 0.50), 0 24px 56px -12px hsl(0 0% 0% / 0.55);

  color-scheme: dark;
}

@theme inline {
  --color-fond: hsl(var(--fond));
  --color-texte: hsl(var(--texte));
  --color-surface: hsl(var(--surface));
  --color-surface-texte: hsl(var(--surface-texte));
  --color-attenue: hsl(var(--attenue));
  --color-attenue-texte: hsl(var(--attenue-texte));
  --color-accent: hsl(var(--accent));
  --color-accent-texte: hsl(var(--accent-texte));
  --color-primaire: hsl(var(--primaire));
  --color-primaire-texte: hsl(var(--primaire-texte));
  --color-or: hsl(var(--or));
  --color-danger: hsl(var(--danger));
  --color-danger-texte: hsl(var(--danger-texte));
  --color-succes: hsl(var(--succes));
  --color-alerte: hsl(var(--alerte));
  --color-info: hsl(var(--info));
  --color-bordure: hsl(var(--bordure));
  --color-ligne: hsl(var(--ligne));
  --color-champ: hsl(var(--champ));
  --color-anneau: hsl(var(--anneau));
  --color-barre: hsl(var(--barre));
  --color-barre-texte: hsl(var(--barre-texte));
  --color-barre-attenue: hsl(var(--barre-attenue));
  --color-barre-actif: hsl(var(--barre-actif));
}

/* ========================================================================== */

* {
  border-color: hsl(var(--bordure));
}

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  background-color: hsl(var(--fond));
  color: hsl(var(--texte));
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  -webkit-font-smoothing: antialiased;
  overscroll-behavior-y: none;
}

/* Zones sures des ecrans a encoche : indispensable en usage tablette. */
:root {
  --marge-sure-bas: env(safe-area-inset-bottom, 0px);
  --marge-sure-haut: env(safe-area-inset-top, 0px);
}

/* Les tableaux larges defilent DANS leur conteneur : la page elle-meme ne doit
   jamais defiler horizontalement, sous peine de rendre la navigation penible
   sur tablette. */
.defilement-x {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
}

.defilement-x::-webkit-scrollbar {
  height: 6px;
}
.defilement-x::-webkit-scrollbar-thumb {
  background: hsl(var(--bordure));
  border-radius: 3px;
}

/* =============================================================================
   Quadrillage des tableaux
   -----------------------------------------------------------------------------
   Un tableau de gestion se lit en suivant une ligne sur quinze colonnes ET en
   comparant une colonne sur cinquante lignes. Les deux mouvements ont besoin
   d'un guide : filet horizontal entre les lignes, filet vertical entre les
   colonnes. Le zebrage, lui, salit la lecture des nombres.

   `--filet` vaut `ligne` par defaut ; un tableau peut le redefinir localement.
   ========================================================================== */
.grille {
  --filet: hsl(var(--ligne));
  border-collapse: separate;
  border-spacing: 0;
}

.grille > thead > tr > th,
.grille > tbody > tr > td,
.grille > tfoot > tr > td {
  border-bottom: 1px solid var(--filet);
  border-right: 1px solid var(--filet);
}

/* Derniere colonne : pas de trait a droite, le contour de la carte suffit. */
.grille > thead > tr > th:last-child,
.grille > tbody > tr > td:last-child,
.grille > tfoot > tr > td:last-child {
  border-right: 0;
}

/* Derniere ligne : idem en bas. */
.grille > tbody > tr:last-child > td {
  border-bottom: 0;
}

/* L'en-tete se detache d'un trait plus marque. */
.grille > thead > tr > th {
  border-bottom-color: hsl(var(--bordure));
}

/* Cible tactile minimale de 44 px : saisie au magasin, souvent avec des gants. */
@media (pointer: coarse) {
  button,
  a[role="button"],
  input,
  select,
  [role="option"] {
    min-height: 44px;
  }

  /* LA REGLE CI-DESSUS ABIME LES CASES A COCHER, ET IL FAUT LE CORRIGER ICI.
     `input` les inclut : une case garde sa largeur native de 12 px et prend
     44 px de haut. On obtient une lamelle verticale — une cible PIRE qu'avant,
     puisqu'elle est plus difficile a viser qu'un carre de 12 px et qu'elle
     ment sur sa zone sensible.

     Une case cochee se vise par son cote, pas par sa hauteur : on lui rend
     donc un carre franc de 22 px. La cible de 44 px reste atteinte par le
     LABEL qui l'entoure, cliquable lui aussi — c'est ainsi qu'on gagne de la
     surface sans deformer la case. */
  input[type="checkbox"],
  input[type="radio"] {
    width: 22px;
    height: 22px;
    min-height: 22px;
    flex: none;
  }

  /* Le label d'une case porte la cible : c'est lui qu'on touche. */
  label:has(> input[type="checkbox"]),
  label:has(> input[type="radio"]) {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* UN SELECTEUR DOIT MONTRER SON CONTENU. A 87 px, « Toutes les categories »
     se reduit a « Toutes… » : on ne sait plus sur quoi on filtre. La moitie
     d'un telephone est le minimum lisible. */
  select {
    min-width: 8rem;
  }
}

/* Barre de titre Tauri : la fenetre est sans decoration native, on rend cette
   bande deplacable. */
.zone-glisser {
  -webkit-app-region: drag;
  app-region: drag;
}
.zone-glisser button,
.zone-glisser a,
.zone-glisser input {
  -webkit-app-region: no-drag;
  app-region: no-drag;
}

@media print {
  .sans-impression,
  .impression-masquee {
    display: none !important;
  }

  /* Un document imprimable sort de la coquille de l'application : sans cela,
     l'entete, la navigation et les marges de l'ecran partent a l'imprimante
     avec lui, et le bon tient sur deux pages au lieu d'une. */
  .zone-impression {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    width: 100%;
    background: #fff;
    color: #000;
    box-shadow: none;
  }

  /* Les couleurs de fond des tableaux sont supprimees par defaut a
     l'impression : on force celles qui portent du sens (entetes, totaux). */
  .zone-impression * {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* Une ligne de tableau ne doit jamais etre coupee entre deux pages. */
  .zone-impression tr {
    break-inside: avoid;
  }

  /* L'entete du tableau se repete en haut de chaque page. Sans cela, la
     deuxieme page d'un etat de deux cents mouvements arrive sans nom de
     colonne, et devient illisible. */
  .zone-impression thead {
    display: table-header-group;
  }

  /* Le pied de page suit le document plutot que de se repeter : un etat de
     trois pages n'a pas besoin de trois fois la mention d'edition, mais il
     doit la porter au moins une fois. */
  .zone-impression tfoot {
    display: table-row-group;
  }

  /* Un titre ne reste jamais seul en bas de page. */
  .zone-impression h2,
  .zone-impression h3 {
    break-after: avoid;
  }

  @page {
    size: A4;
    margin: 12mm;
  }
}

@keyframes apparition {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.apparition {
  animation: apparition 0.15s ease-out;
}

/* =============================================================================
   Densite des tableaux
   -----------------------------------------------------------------------------
   Un seul reglage, applique par une variable plutot que par des classes
   conditionnelles dans chaque tableau : les vingt-cinq ecrans en heritent sans
   qu'aucun ait a connaitre la preference.

   Le padding VERTICAL seul change. L'horizontal reste fixe : reduire aussi les
   marges laterales collerait les colonnes de chiffres entre elles, et c'est
   precisement ce qu'on cherche a eviter en mode compact.
   ========================================================================== */
:root {
  --densite-y: 5px;
}
:root[data-densite='compacte'] {
  --densite-y: 2px;
}
:root[data-densite='aeree'] {
  --densite-y: 9px;
}

table.grille td {
  padding-top: var(--densite-y);
  padding-bottom: var(--densite-y);
}


/* --- La marque suit le theme ------------------------------------------------
   Le logo existe en prune et en blanc. Prune sur une barre sombre serait
   illisible, blanc sur une barre claire disparaitrait : on charge les deux et
   on n'en montre qu'un. Basculer l'attribut `src` produirait un clignotement
   au changement de theme, le temps que la seconde image se decode. */
.marque-sombre { display: none; }
.sombre .marque-claire { display: none; }
.sombre .marque-sombre { display: block; }

/* =============================================================================
   ATTENTE, RELIEF, MICRO-GESTES
   -----------------------------------------------------------------------------
   Trois effets seulement, et les trois disent quelque chose de vrai : « ca
   charge », « ceci est pose sur cela », « votre geste a ete pris ». Tout le
   reste serait de la decoration, et la decoration vieillit mal.
   ========================================================================== */

/* LA LUEUR QUI TRAVERSE, plutot que le clignotement.
   `animate-pulse` fait battre un bloc gris : on regarde du vide qui bat. Une
   lueur qui balaie le bloc va dans le sens de la lecture et suggere un travail
   en cours. Meme duree d'attente, impression de rapidite differente. */
.squelette {
  position: relative;
  overflow: hidden;
}
.squelette::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background-image: linear-gradient(
    90deg,
    transparent 0%,
    hsl(var(--surface) / 0.75) 45%,
    hsl(var(--surface) / 0.75) 55%,
    transparent 100%
  );
  animation: lueur-attente 1.4s ease-in-out infinite;
}
@keyframes lueur-attente {
  100% { transform: translateX(100%); }
}

/* LA CARTE QUI MENE QUELQUE PART SE SOULEVE AU SURVOL.
   Une carte cliquable et une carte informative se ressemblaient trait pour
   trait. Un demi-pixel d'elevation et une bordure qui prend la teinte de
   l'accent suffisent a dire « celle-ci s'ouvre » — sans ajouter ni fleche ni
   texte « cliquez ici ». */
.carte-active {
  transition:
    transform var(--transition-douce),
    box-shadow var(--transition-douce),
    border-color var(--transition-douce);
}
.carte-active:hover {
  transform: translateY(-1px);
  border-color: hsl(var(--primaire) / 0.35);
  box-shadow: var(--ombre-levee);
}

/* LE FILET D'OR, signature de la maison.
   Pose en haut d'une carte que l'on veut distinguer : il marque sans colorer
   le bloc entier, ce qui serait lourd sur un ecran deja dense. */
.filet-or {
  position: relative;
}
.filet-or::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  border-radius: var(--radius) var(--radius) 0 0;
  background-image: linear-gradient(
    90deg,
    hsl(var(--or) / 0.15),
    hsl(var(--or) / 0.85) 35%,
    hsl(var(--or) / 0.85) 65%,
    hsl(var(--or) / 0.15)
  );
}

/* LE CHIFFRE QUI COMPTE S'INSTALLE, il n'apparait pas.
   Cent quatre-vingts millisecondes de montee : on percoit que la valeur vient
   d'arriver, ce qui evite de croire qu'elle etait deja la et qu'on l'avait mal
   lue. Au-dela, l'attente devient perceptible ; en deca, l'effet est perdu. */
@keyframes valeur-arrive {
  from { opacity: 0; transform: translateY(3px); }
  to   { opacity: 1; transform: none; }
}
.valeur-arrive {
  animation: valeur-arrive 180ms cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* RIEN DE TOUT CELA POUR QUI A DEMANDE LE CALME.
   Un systeme regle sur « animations reduites » le demande pour une raison —
   vertiges, migraines, fatigue visuelle. On respecte, sans rien perdre du
   contenu. */
@media (prefers-reduced-motion: reduce) {
  .squelette::after { animation: none; }
  .carte-active:hover { transform: none; }
  .valeur-arrive { animation: none; }
}
</file>

