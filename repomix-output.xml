INSERT INTO permission (code_role_user, module, action)
             SELECT 'DIRECTION', module, 'LIRE'   FROM _matrice WHERE strpos(DIRECTION,'R') > 0
    UNION ALL SELECT 'DIRECTION', module, 'ECRIRE' FROM _matrice WHERE strpos(DIRECTION,'W') > 0
    UNION ALL SELECT 'PLANIF',    module, 'LIRE'   FROM _matrice WHERE strpos(PLANIF,'R')    > 0
    UNION ALL SELECT 'PLANIF',    module, 'ECRIRE' FROM _matrice WHERE strpos(PLANIF,'W')    > 0
    UNION ALL SELECT 'ACHAT',     module, 'LIRE'   FROM _matrice WHERE strpos(ACHAT,'R')     > 0
    UNION ALL SELECT 'ACHAT',     module, 'ECRIRE' FROM _matrice WHERE strpos(ACHAT,'W')     > 0
    UNION ALL SELECT 'MAGASIN',   module, 'LIRE'   FROM _matrice WHERE strpos(MAGASIN,'R')   > 0
    UNION ALL SELECT 'MAGASIN',   module, 'ECRIRE' FROM _matrice WHERE strpos(MAGASIN,'W')   > 0
    UNION ALL SELECT 'QUALITE',   module, 'LIRE'   FROM _matrice WHERE strpos(QUALITE,'R')   > 0
    UNION ALL SELECT 'QUALITE',   module, 'ECRIRE' FROM _matrice WHERE strpos(QUALITE,'W')   > 0
    UNION ALL SELECT 'DAF',       module, 'LIRE'   FROM _matrice WHERE strpos(DAF,'R')       > 0
    UNION ALL SELECT 'DAF',       module, 'ECRIRE' FROM _matrice WHERE strpos(DAF,'W')       > 0;

DROP TABLE _matrice;

