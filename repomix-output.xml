<file path="deploiement/gestionfil.service">
# =============================================================================
# Service systemd — ERP Gestion Fil
# -----------------------------------------------------------------------------
# Installation :
#     sudo cp gestionfil.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now gestionfil
#
# Journal :
#     journalctl -u gestionfil -f
# =============================================================================

[Unit]
Description=ERP Gestion Fil — Polyfashions Carpet Morocco
Documentation=file:/opt/gestionfil/README.md

# `After` NE SUFFIT PAS. Il ordonne le demarrage mais n'attend pas que
# PostgreSQL accepte les connexions : le service demarrerait, echouerait a se
# connecter, et redemarrerait en boucle pendant quelques secondes au chaque
# reboot. `Requires` lie les deux — si PostgreSQL s'arrete, le service s'arrete
# aussi, au lieu de servir des erreurs 500.
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

# LA LIMITE DE REDEMARRAGE SE DECLARE ICI, PAS DANS [Service]. Elle y etait, et
# systemd la refusait a chaque lecture de l'unite : « Unknown key
# 'StartLimitIntervalSec' in section [Service], ignoring. » Le compteur
# appartient a l'unite, pas au processus : c'est l'unite qu'on empeche de
# renaitre.
#
# CE QUI S'APPLIQUAIT A LA PLACE, ET POURQUOI C'ETAIT PIRE QUE RIEN. La cle
# ignoree, systemd retombait sur son defaut : cinq demarrages en DIX secondes.
# Avec RestartSec=5, deux tentatives tiennent dans dix secondes — jamais cinq.
# La limite etait donc inatteignable : un ERP qui ne peut pas demarrer (base
# injoignable, .env casse) repartait toutes les cinq secondes, indefiniment,
# sans jamais s'arreter sur son echec. La panne se cachait au lieu de se voir.
#
# Sur une minute, les memes cinq tentatives tiennent en vingt-cinq secondes :
# la limite se declenche, le service reste arrete, et `systemctl status` dit
# pourquoi.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=gestionfil
Group=gestionfil
WorkingDirectory=/opt/gestionfil

# La configuration vit dans un fichier separe, lisible par le seul compte du
# service : il porte le mot de passe de la base et le secret des jetons.
EnvironmentFile=/opt/gestionfil/.env

ExecStart=/opt/gestionfil/gestionfil

# --- Redemarrage -------------------------------------------------------------
# `always` et non `on-failure` : un arret propre non demande — un OOM killer,
# une exception non rattrapee dans un thread — doit aussi relancer le service.
# Un ERP qui s'arrete a 14 h et attend le lendemain matin qu'on s'en apercoive
# coute plus cher qu'un redemarrage de trop.
Restart=always
RestartSec=5
# La limite qui va avec (cinq tentatives en une minute) est declaree dans
# [Unit] : systemd n'en veut pas ici.

# --- Cloisonnement -----------------------------------------------------------
# Le service ne fait que trois choses : ecouter un port, parler a PostgreSQL sur
# la boucle locale, et ecrire des sauvegardes. Tout le reste lui est interdit.
#
# Ce n'est pas de la precaution abstraite : une faille dans une dependance
# donnerait sans cela un acces au systeme de fichiers entier, avec les
# sauvegardes dedans — c'est-a-dire toute la base, prix et empreintes de mots de
# passe compris.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Les deux seuls chemins ou le service peut ecrire.
# Les paquets clients sont en LECTURE SEULE pour le service : il les sert, il
# ne les fabrique pas. Un installateur se depose par SSH, jamais par l'API —
# une application qui peut ecrire les binaires qu'elle distribue est une
# application dont une faille suffit a contaminer tous les postes.
ReadWritePaths=/opt/gestionfil/sauvegardes /opt/gestionfil/journaux

# Familles d'adresses : IPv4, IPv6, et le socket UNIX de PostgreSQL.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# --- Journal -----------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gestionfil

[Install]
WantedBy=multi-user.target
</file>

<file path="deploiement/nginx-gestionfil.conf">
# =============================================================================
# Gestion Fil — terminaison TLS
# -----------------------------------------------------------------------------
# Destination : /etc/nginx/sites-available/gestionfil, lie depuis sites-enabled.
#
# nginx est le SEUL service expose au reseau. L'application ecoute sur
# 127.0.0.1:8080 et ne recoit que ce qui passe par ici ; PostgreSQL n'a jamais
# ecoute ailleurs que sur la boucle locale.
#
# CE FICHIER N'EXISTAIT QUE SUR LE SERVEUR, et cela s'est paye cher — voir plus
# bas. Il est desormais versionne : ce qui tient l'acces de toute l'entreprise
# se relit, se compare et se restaure comme le reste du code.
# =============================================================================

server {
    # `default_server` : VOIR LE BLOC 443 CI-DESSOUS, MEME RAISON. Sans lui,
    # /ca.crt — le certificat que les tablettes et les telephones doivent
    # telecharger pour reconnaitre le serveur — part chez le premier site venu,
    # qui repond 404.
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # LE CERTIFICAT RACINE, SERVI EN CLAIR, ET C'EST VOULU.
    # Un iPad ou un telephone ne sait pas installer un fichier venu d'ailleurs :
    # il faut pouvoir l'ouvrir depuis le navigateur. Un certificat public n'est
    # pas un secret — c'est meme sa raison d'etre.
    location = /ca.crt {
        alias /var/www/gestionfil/ca.crt;
        default_type application/x-x509-ca-cert;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    # `default_server` EST LA POUR UNE PANNE REELLE, LE 18/09/2026.
    #
    # Tout le monde ici tape https://192.168.1.140 — une ADRESSE, pas un nom.
    # Aucun `server_name` ne peut donc matcher : nginx confie la demande au
    # serveur PAR DEFAUT du port. A defaut de declaration explicite, ce defaut
    # est simplement LE PREMIER BLOC `listen 443` RENCONTRE — et l'ordre de
    # lecture de sites-enabled est alphabetique.
    #
    # Ce jour-la, une seconde application (« caisse-amal ») a ete installee sur
    # la meme machine. Elle avait pourtant pris soin de ne reclamer que son
    # propre nom et son propre port. Mais « caisse-amal » precede « gestionfil »
    # dans l'alphabet : son bloc 443 est devenu le defaut, et TOUTE L'ENTREPRISE
    # a vu la caisse en ouvrant l'ERP — sans qu'une seule ligne de Gestion Fil
    # ait change.
    #
    # Le commentaire d'alors disait deja « le bloc par defaut ci-dessus ». Il
    # l'etait par accident d'ordre, pas par declaration. Un mot manquait.
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/gestionfil-pki/serveur.crt;
    ssl_certificate_key /etc/gestionfil-pki/serveur.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # PAS DE HSTS. Il forcerait les navigateurs a refuser tout retour au HTTP
    # pendant des mois — y compris si ce certificat devait etre abandonne. Sur
    # une adresse IP et une autorite privee, c'est un aller sans retour.

    # Les sauvegardes et les paquets se telechargent par ici.
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# LE NOM, AVEC SON CERTIFICAT PUBLIC.
#
# Le bloc par defaut ci-dessus sert l'ADRESSE IP avec l'autorite interne : un
# poste qui tape encore https://192.168.1.140 ne doit pas se voir refuser. Ce
# bloc-ci sert le NOM, avec un certificat reconnu par tous les appareils — sans
# quoi les telephones refusent d'installer l'application.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name erp-polyfashions.dedyn.io;

    ssl_certificate     /etc/gestionfil-pki/public/serveur.crt;
    ssl_certificate_key /etc/gestionfil-pki/public/serveur.key;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
</file>

