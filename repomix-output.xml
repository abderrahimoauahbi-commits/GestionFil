import { readFileSync } from 'node:fs'
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
import tailwindcss from '@tailwindcss/vite'
import { VitePWA } from 'vite-plugin-pwa'

const hoteTauri = !!process.env.TAURI_ENV_PLATFORM

// La version vient de `package.json` : un seul endroit ou elle est
// declaree, et c'est celui que la publication verifie.
const paquet = JSON.parse(
  readFileSync(new URL('./package.json', import.meta.url), 'utf8'),
) as { version: string }

export default defineConfig({
  define: {
    __VERSION__: JSON.stringify(paquet.version),
  },
  plugins: [
    react(),
    tailwindcss(),
    VitePWA({
      registerType: 'autoUpdate',
      includeAssets: ['favicon.svg', 'icone-192.png', 'icone-512.png'],
      manifest: {
        name: 'Gestion Fil - Polyfashions Carpet',
        short_name: 'Gestion Fil',
        description: 'Pilotage des achats, stocks et production de matieres premieres',
        lang: 'fr',
        start_url: '/',
        scope: '/',
        display: 'standalone',
        orientation: 'any',
        background_color: '#0f172a',
        theme_color: '#0f172a',
        categories: ['business', 'productivity'],
        icons: [
          { src: 'icone-192.png', sizes: '192x192', type: 'image/png' },
          { src: 'icone-512.png', sizes: '512x512', type: 'image/png' },
          { src: 'icone-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' },
        ],
        shortcuts: [
          { name: 'Cockpit', url: '/', description: 'Indicateurs du jour' },
          { name: 'Mouvements', url: '/mouvements', description: 'Saisir un mouvement de stock' },
          { name: 'Receptions', url: '/receptions', description: 'Peser une reception' },
        ],
      },
      workbox: {
        globPatterns: ['**/*.{js,css,html,svg,png,woff2}'],
        // L'API n'est JAMAIS mise en cache : afficher un stock perime serait
        // pire que de ne rien afficher. L'application est concue pour
        // fonctionner connectee (ADR-001, mode toujours relie au serveur).
        navigateFallbackDenylist: [/^\/api/],
        runtimeCaching: [],
        cleanupOutdatedCaches: true,
      },
      devOptions: { enabled: false },
      // Dans l'enveloppe Tauri, le service worker n'apporte rien : les fichiers
      // sont deja servis depuis le disque.
      disable: hoteTauri,
    }),
  ],

  server: {
    // `true` = 0.0.0.0. Sans cela Vite n'ecoute que la boucle locale, et l'ecran
    // reste invisible depuis un telephone ou une tablette du site — ce qui rend
    // impossible l'essai de la saisie mobile la ou elle sera utilisee.
    host: true,
    port: 5173,
    strictPort: true,
    // Le front appelle /api sans connaitre l'hote du backend : la meme
    // configuration sert au navigateur, a Tauri et a la PWA.
    proxy: {
      '/api': { target: 'http://127.0.0.1:8080', changeOrigin: true },
    },
  },

  // Tauri sert les fichiers depuis le disque : chemins relatifs obligatoires.
  base: hoteTauri ? './' : '/',

  build: {
    outDir: 'dist',
    assetsDir: 'assets',
    target: hoteTauri ? 'esnext' : 'es2020',
    sourcemap: false,
    rollupOptions: {
      output: {
        // Separe les dependances stables du code applicatif : une correction
        // metier ne fait pas retelecharger React et Radix.
        manualChunks: {
          react: ['react', 'react-dom', 'react-router-dom'],
          donnees: ['@tanstack/react-query', '@tanstack/react-table'],
          interface: ['lucide-react', 'sonner'],
        },
      },
    },
  },

  clearScreen: false,
})
</file>

<file path=".glass_ancien.css">
/* -----------------------------------------------------------------------------
   Le verre.
   -----------------------------------------------------------------------------
   Valeurs reprises de la specification de reference du tableau de bord
   glassmorphique, et non inventees : fond indigo profond, halos bleu et violet,
   surfaces a 10 % de blanc, flou de 16 px avec saturation a 150 %, bordure
   blanche a 25 %, rayon de 16 px, ombre portee a 32 px.

   LA REGLE QUI COMPTE, et qui est celle de la source : le verre habille le
   CHROME — barre laterale, barre du haut, cartes d'indicateurs. Les surfaces
   DENSES EN DONNEES restent quasi opaques, a 90 %, pour tenir un contraste de
   4,5:1. Un flou derriere un petit chiffre produit un halo qui le rend penible
   a lire, et c'est exactement ce qu'on fait ici huit heures par jour.
   -------------------------------------------------------------------------- */

/* Le fond : sans lui le flou ne floute rien. */
:root[data-palette="glassier"] body,
.atelier[data-palette="glassier"] {
  background-color: #f2f4fb;
  background-image:
    radial-gradient(at 15% 12%, rgb(102 126 234 / 0.30) 0px, transparent 55%),
    radial-gradient(at 85% 8%, rgb(118 75 162 / 0.26) 0px, transparent 50%),
    radial-gradient(at 55% 92%, rgb(102 126 234 / 0.18) 0px, transparent 52%);
  background-attachment: fixed;
}

:root.sombre[data-palette="glassier"] body,
.atelier.sombre[data-palette="glassier"] {
  background-color: #0f172a;
  background-image:
    radial-gradient(at 15% 12%, rgb(102 126 234 / 0.38) 0px, transparent 55%),
    radial-gradient(at 85% 8%, rgb(118 75 162 / 0.32) 0px, transparent 50%),
    radial-gradient(at 55% 92%, rgb(102 126 234 / 0.22) 0px, transparent 52%);
  background-attachment: fixed;
}

/* Le chrome : barres, cartes d'indicateurs, graphiques, menus, tiroirs.
   Une carte QUI PORTE UN TABLEAU en est exclue : c'est une surface de donnees,
   traitee plus bas. Le faire ici, par `:has`, evite de flouter une surface pour
   la deflouter ensuite — et evite surtout la dizaine de couches de flou que
   compterait un ecran de saisie. */
:root[data-palette="glassier"] header,
:root[data-palette="glassier"] aside,
:root[data-palette="glassier"] footer,
:root[data-palette="glassier"] .carte:not(:has(table)),
:root[data-palette="glassier"] .viz,
