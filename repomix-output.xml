      compte('nb_references', 'References'),
    ],
    champs: [
      { champ: 'code_groupe_equiv', libelle: 'Code', obligatoire: true, cleCreation: true },
      { champ: 'libelle', libelle: 'Libelle', obligatoire: true },
      {
