                >
                  {libelleRole(role)} {fmt.nombre(somme, 2)} %
                </Badge>
              ))}
              {coutTotalM2 !== null && (
                <span className="text-[11px] text-attenue-texte">
                  Cout matiere :{' '}
                  <span className="font-semibold tabular-nums text-texte">
