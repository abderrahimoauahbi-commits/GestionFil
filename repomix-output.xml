                    ROUND(jours_couverture) AS jours_couverture,
                    ROUND(stock_physique_net_kg) AS stock_kg,
                    fournisseur_nom
             FROM v_stock_projete
             WHERE statut <> 'OK'
             ORDER BY CASE statut WHEN 'RUPTURE' THEN 0 WHEN 'CRITIQUE' THEN 1 ELSE 2 END,
                      jours_couverture
