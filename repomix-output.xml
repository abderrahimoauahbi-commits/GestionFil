-- -----------------------------------------------------------------------------
-- 5. Les droits effectifs, rederives
-- -----------------------------------------------------------------------------
-- SANS CETTE ETAPE, LES DEUX BLOCS PRECEDENTS SONT DECORATIFS : le serveur ne
-- lit jamais le modele de role, il lit `droit_champ`, utilisateur par
-- utilisateur. Mohamed garderait donc la grille de DIRECTION.
DELETE FROM droit_champ
 WHERE id_utilisateur IN (SELECT id_utilisateur FROM utilisateur
                           WHERE login IN ('Mohamed', 'Assistante'));

INSERT INTO droit_champ (id_utilisateur, module, champ, niveau, date_modification)
SELECT u.id_utilisateur, c.module, c.champ,
       CASE
         WHEN u.code_role_user = 'ADMIN' THEN 'ECRITURE'
         WHEN NOT EXISTS (SELECT 1 FROM permission p
                           WHERE p.code_role_user = u.code_role_user
                             AND p.module = c.module AND p.action = 'LIRE'
                             AND p.actif = 1) THEN 'MASQUE'
         WHEN c.sensible = 1
              AND c.module IN ('BONS_COMMANDE', 'RECEPTIONS', 'PLAN_ACHAT') THEN 'ECRITURE'
         WHEN c.sensible = 1 THEN 'MASQUE'
         ELSE 'ECRITURE'
       END,
       to_char(now() AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"')
  FROM utilisateur u
 CROSS JOIN champ_configurable c
 WHERE u.login IN ('Mohamed', 'Assistante');

