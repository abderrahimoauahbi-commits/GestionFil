                          {erp && l.unite === 'kg' ? (
                            <span className="block pt-1 text-right tabular-nums text-attenue-texte">= poids</span>
                          ) : (
                            <Champ className={cn(champ, 'text-right')} inputMode="decimal" value={l.quantite} disabled={fige}
