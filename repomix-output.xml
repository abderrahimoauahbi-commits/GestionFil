        // Mieux vaut ignorer un fichier que deviner sa plateforme : un paquet
        // mal etiquete installe sur un poste est pire qu'un paquet absent.
        assert_eq!(decrire("setup.exe"), None);
        assert_eq!(decrire("gestionfil.exe"), None);
