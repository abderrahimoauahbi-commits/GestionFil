UPDATE permission SET actif = 0
 WHERE code_role_user = 'ASSISTANTE'
   AND (module = 'COCKPIT'
        OR (module IN ('QUALITES', 'RECETTES') AND action IN ('ECRIRE', 'VALIDER')));

