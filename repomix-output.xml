              <DataTable
                module={MODULE}
                colonnes={colonnesCompo}
                lignes={composition}
                cle={(c) => c.cle}
                recherche={false}
                pagination={false}
                tailleParDefaut={500}
                titreCarte={(c) => `${libelleRole(c.code_role)} · ${c.code_reference}`}
                videTitre="Aucune composition"
