  ('STOCK', 'valeur_conso_annuelle_mad', 'Valeur de consommation annuelle (MAD)', 'LECTURE', 1, 910),
  ('STOCK', 'part_pct',                  'Part dans la depense totale (%)',       'LECTURE', 1, 911),
  ('STOCK', 'pct_cumule',                'Part cumulee (%)',                      'LECTURE', 1, 912),
